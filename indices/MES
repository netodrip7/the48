"""
MES — Momentum Elasticity Score
The 48 | World Cup 2026 Analytics Platform

Higher score = better momentum recovery = more elastic.
Scale: 0 to 100.

Weights:
    Elasticity (recovery)    40%
    Collapse risk            35%
    Penalty composure        25%
"""

import pandas as pd
import numpy as np
import os

HIST_PATH   = r"C:/Users/Deepak Singh/OneDrive/Desktop/wc26/historical_wc.csv"
OUTPUT_PATH = r"C:/Users/Deepak Singh/OneDrive/Desktop/wc26/data/processed/mes_scores.csv"

# 48 qualified countries
QUALIFIED = [
    "Argentina", "Australia", "Belgium", "Bolivia", "Bosnia and Herzegovina",
    "Brazil", "Canada", "Cape Verde", "Chile", "Colombia", "Croatia", "Czechia",
    "Côte d'Ivoire", "DR Congo", "Ecuador", "Egypt", "England", "France",
    "Germany", "Ghana", "Haiti", "Iran", "Iraq", "Japan", "Jordan", "Mexico",
    "Morocco", "Netherlands", "New Zealand", "Norway", "Panama", "Paraguay",
    "Portugal", "Qatar", "Saudi Arabia", "Scotland", "Senegal", "South Africa",
    "South Korea", "Spain", "Sweden", "Switzerland", "Türkiye", "Tunisia",
    "United States", "Uruguay", "Uzbekistan", "Curaçao",
]

NAME_MAP = {
    "Turkey":           "Türkiye",
    "Ivory Coast":      "Côte d'Ivoire",
    "Czech Republic":   "Czechia",
    "Congo DR":         "DR Congo",
    "USA":              "United States",
    "Korea Republic":   "South Korea",
    "Bosnia & H.":      "Bosnia and Herzegovina",
    "IR Iran":          "Iran",
    "West Germany":     "Germany",
    "Soviet Union":     "Russia",
}

WEIGHTS = {
    "elasticity":  0.40,
    "collapse":    0.35,
    "penalty":     0.25,
}

INVERT = {
    "comeback_wins":        False,
    "recovered_after_rc":   False,
    "held_on_after_rc":     False,
    "collapses_after_rc":   True,
    "times_losing_at_ht":   True,
    "penalty_ratio":        False,
}


def min_max_scale(series: pd.Series, invert: bool = False) -> pd.Series:
    mn, mx = series.min(), series.max()
    if mx == mn:
        return pd.Series([0.5] * len(series), index=series.index)
    scaled = (series - mn) / (mx - mn)
    return 1 - scaled if invert else scaled


def main():
    df = pd.read_csv(HIST_PATH)
    df["team"] = df["team"].replace(NAME_MAP)

    # ── Aggregate all tournaments per country ─────────────────────────────────
    agg = df.groupby("team").agg(
        comeback_wins       = ("comeback_wins",       "sum"),
        recovered_after_rc  = ("recovered_after_rc",  "sum"),
        held_on_after_rc    = ("held_on_after_rc",    "sum"),
        collapses_after_rc  = ("collapses_after_rc",  "sum"),
        times_losing_at_ht  = ("times_losing_at_ht",  "sum"),
        went_to_penalties   = ("went_to_penalties",   "sum"),
        won_penalties       = ("won_penalties",       "sum"),
        matches_played      = ("matches_played",      "sum"),
    ).reset_index()

    # ── Filter to qualified only ───────────────────────────────────────────────
    agg = agg[agg["team"].isin(QUALIFIED)].copy()

    # ── Add missing qualified teams with zeros (first timers) ─────────────────
    missing = set(QUALIFIED) - set(agg["team"])
    if missing:
        zeros = pd.DataFrame({"team": list(missing)})
        for col in agg.columns:
            if col != "team":
                zeros[col] = 0
        agg = pd.concat([agg, zeros], ignore_index=True)

    # ── Normalise by matches played to avoid big-nation bias ──────────────────
    for col in ["comeback_wins", "recovered_after_rc", "held_on_after_rc",
                "collapses_after_rc", "times_losing_at_ht"]:
        agg[col] = agg[col] / agg["matches_played"].replace(0, 1)

    # ── Penalty composure ratio ───────────────────────────────────────────────
    agg["penalty_ratio"] = agg.apply(
        lambda r: r["won_penalties"] / r["went_to_penalties"]
        if r["went_to_penalties"] > 0 else 0.5,
        axis=1
    )

    # ── Score each category ───────────────────────────────────────────────────
    agg["elasticity_score"] = (
        min_max_scale(agg["comeback_wins"],      invert=False) +
        min_max_scale(agg["recovered_after_rc"], invert=False) +
        min_max_scale(agg["held_on_after_rc"],   invert=False)
    ) / 3

    agg["collapse_score"] = (
        min_max_scale(agg["collapses_after_rc"],  invert=True) +
        min_max_scale(agg["times_losing_at_ht"],  invert=True)
    ) / 2

    agg["penalty_score"] = min_max_scale(agg["penalty_ratio"], invert=False)

    # ── Weighted composite ────────────────────────────────────────────────────
    agg["mes_raw"] = (
        agg["elasticity_score"] * WEIGHTS["elasticity"] +
        agg["collapse_score"]   * WEIGHTS["collapse"]   +
        agg["penalty_score"]    * WEIGHTS["penalty"]
    )

    agg["mes_score"] = (agg["mes_raw"] * 100).round(2)
    agg["mes_rank"]  = agg["mes_score"].rank(ascending=False).astype(int)

    # ── Tournament adjustment column (starts at 0, updated each match day) ────
    agg["tournament_adjustment"] = 0.0
    agg["mes_live"] = agg["mes_score"]

    output_cols = [
        "team", "mes_score", "mes_rank", "mes_live",
        "tournament_adjustment",
        "elasticity_score", "collapse_score", "penalty_score",
    ]

    result = agg[output_cols].sort_values("mes_rank").reset_index(drop=True)

    os.makedirs(os.path.dirname(OUTPUT_PATH), exist_ok=True)
    result.to_csv(OUTPUT_PATH, index=False)

    print("MES complete. Output saved to:")
    print(OUTPUT_PATH)
    print()
    print(result.to_string(index=False))


if __name__ == "__main__":
    main()
