"""
SCI — Structural Ceiling Index
The 48 | World Cup 2026 Analytics Platform

Higher score = closer to or exceeding structural ceiling = better.
Scale: 0 to 100.

Weights:
    Historical Performance   35%
    Efficiency Gap           40%
    Current Benchmark        25%
"""

import pandas as pd
import numpy as np
import os

HIST_PATH    = r"C:/Users/Deepak Singh/OneDrive/Desktop/wc26/historical_wc.csv"
SQUADS_PATH  = r"C:/Users/Deepak Singh/OneDrive/Desktop/wc26/squad_values.csv"
TEAMS_PATH   = r"C:\Users\Deepak Singh\OneDrive\Desktop\wc26\national_teams - Sheet1.csv"
OUTPUT_PATH  = r"C:/Users/Deepak Singh/OneDrive/Desktop/wc26/data/processed/sci_scores.csv"

NAME_MAP = {
    "Turkey":           "Türkiye",
    "Ivory Coast":      "Côte d'Ivoire",
    "Czech Republic":   "Czechia",
    "Congo DR":         "DR Congo",
    "USA":              "United States",
    "Korea Republic":   "South Korea",
    "Bosnia & H.":      "Bosnia and Herzegovina",
    "IR Iran":          "Iran",
    "West Germany":     "Germany",
}

STAGE_MAP = {
    "Group Stage":  1,
    "Second Round": 2,
    "Round of 16":  2,
    "Quarter-final":3,
    "Fourth":       4,
    "Third":        5,
    "Final":        6,
    "Winner":       7,
}

WEIGHTS = {
    "historical":  0.35,
    "efficiency":  0.40,
    "benchmark":   0.25,
}


def min_max_scale(series: pd.Series, invert: bool = False) -> pd.Series:
    mn, mx = series.min(), series.max()
    if mx == mn:
        return pd.Series([0.5] * len(series), index=series.index)
    scaled = (series - mn) / (mx - mn)
    return 1 - scaled if invert else scaled


def main():
    hist   = pd.read_csv(HIST_PATH)
    squads = pd.read_csv(SQUADS_PATH)
    teams  = pd.read_csv(TEAMS_PATH, encoding='latin1')

    hist["team"]      = hist["team"].replace(NAME_MAP)
    squads["country"] = squads["country"].replace(NAME_MAP)
    teams["country"]  = teams["country"].replace(NAME_MAP)

    # ── Map stage_reached to numeric ──────────────────────────────────────────
    hist["stage_num"] = hist["stage_reached"].map(STAGE_MAP)

    # ── Aggregate historical performance per country ───────────────────────────
    hist_agg = hist.groupby("team").agg(
        avg_stage        = ("stage_num",          "mean"),
        best_stage       = ("stage_num",          "max"),
        total_points     = ("tournament_points",  "sum"),
        total_wins       = ("wins",               "sum"),
        tournaments      = ("year",               "count"),
        avg_goals_for    = ("goals_for",          "mean"),
    ).reset_index().rename(columns={"team": "country"})

    # ── Historical score (normalise by tournaments played) ────────────────────
    hist_agg["points_per_tournament"] = hist_agg["total_points"] / hist_agg["tournaments"]
    hist_agg["wins_per_tournament"]   = hist_agg["total_wins"]   / hist_agg["tournaments"]

    hist_agg["historical_score"] = (
        min_max_scale(hist_agg["avg_stage"])              * 0.35 +
        min_max_scale(hist_agg["best_stage"])             * 0.25 +
        min_max_scale(hist_agg["points_per_tournament"])  * 0.25 +
        min_max_scale(hist_agg["wins_per_tournament"])    * 0.15
    )

    # ── 2026 squad value ──────────────────────────────────────────────────────
    squad_2026 = squads[squads["year"] == 2026][["country", "squad_value_eur"]].copy()

    # ── FIFA ranking score (lower rank number = better, so invert) ────────────
    teams["ranking_score"] = min_max_scale(teams["fifa_ranking"], invert=True)

    # ── Merge everything ──────────────────────────────────────────────────────
    df = teams[["country", "ranking_score"]].merge(
        hist_agg[["country", "historical_score", "avg_stage", "best_stage", "tournaments"]],
        on="country", how="left"
    ).merge(
        squad_2026, on="country", how="left"
    )

    # ── Fill first-timers with 0 historical score ─────────────────────────────
    df["historical_score"] = df["historical_score"].fillna(0)
    df["avg_stage"]        = df["avg_stage"].fillna(0)
    df["best_stage"]       = df["best_stage"].fillna(0)
    df["tournaments"]      = df["tournaments"].fillna(0)

    # ── Efficiency gap ────────────────────────────────────────────────────────
    # Scale squad value: higher value = more resources = higher expectation
    df["squad_value_scaled"] = min_max_scale(df["squad_value_eur"].fillna(df["squad_value_eur"].median()))

    # Efficiency = how much they outperform their squad value
    # Positive = overperforming, negative = underperforming
    df["efficiency_gap"] = df["historical_score"] - df["squad_value_scaled"]

    # Scale efficiency gap to 0-1 (higher = more efficient)
    df["efficiency_score"] = min_max_scale(df["efficiency_gap"])

    # ── Weighted composite ────────────────────────────────────────────────────
    df["sci_raw"] = (
        df["historical_score"]  * WEIGHTS["historical"] +
        df["efficiency_score"]  * WEIGHTS["efficiency"] +
        df["ranking_score"]     * WEIGHTS["benchmark"]
    )

    df["sci_score"] = (df["sci_raw"] * 100).round(2)
    df["sci_rank"]  = df["sci_score"].rank(ascending=False).astype(int)

    output_cols = [
        "country", "sci_score", "sci_rank",
        "historical_score", "efficiency_score", "ranking_score",
        "squad_value_eur", "tournaments",
    ]

    result = df[output_cols].sort_values("sci_rank").reset_index(drop=True)

    os.makedirs(os.path.dirname(OUTPUT_PATH), exist_ok=True)
    result.to_csv(OUTPUT_PATH, index=False)

    print("SCI complete. Output saved to:")
    print(OUTPUT_PATH)
    print()
    print(result.to_string(index=False))


if __name__ == "__main__":
    main()
